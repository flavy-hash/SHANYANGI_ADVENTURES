APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The one main address of the live site, e.g. https://www.shanyangiadventures.co.tz (no trailing
# slash). Canonical links, link previews, structured data, /sitemap.xml and /robots.txt use it.
APP_URL=http://localhost

# Search engines (config/seo.php).
# CANONICAL_REDIRECT=true 301-redirects other host names (www / non-www twin, old domains pointing
# at this folder) to APP_URL. Turn it on only on the live site, once APP_URL is right.
CANONICAL_REDIRECT=false
# Only the content="…" value of the HTML-tag verification method (Google Search Console / Bing).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=shanyangi_adventures
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SITE_WHATSAPP=
SITE_PHONE=

# Protected media (config/media.php)
FFMPEG_BINARY=ffmpeg

# Review badges (config/reviews.php)
TRIPADVISOR_URL=
GOOGLE_REVIEWS_URL=

# Footer contact + social (config/site.php)
SITE_EMAIL=
BOOKINGS_EMAIL=
SITE_ADDRESS=
SITE_INSTAGRAM=
SITE_FACEBOOK=
SITE_TIKTOK=
SITE_YOUTUBE=
SITE_SAFARIBOOKINGS_URL=
SITE_LINKEDIN=

# Visitor activity log (config/analytics.php)
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=180

# Live chat widget + admin time zone (config/site.php)
SITE_LIVE_CHAT=true
SITE_TIMEZONE=Africa/Dar_es_Salaam

# PDF quotations (config/quotes.php)
QUOTE_CURRENCY_SYMBOL=$
QUOTE_VALIDITY_DAYS=30
QUOTE_CHILD_RATE_PERCENT=100
